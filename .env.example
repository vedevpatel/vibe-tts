# Optional, per-machine settings. Copy to .env (gitignored): cp .env.example .env
# Plain KEY=VALUE lines. Variables already set in your shell win over this file.
# Absolute paths (a leading ~ is expanded; $VARS are not).

# Where model weights live. Default: ./models
# Point it at external storage if the repo disk is small, e.g. VIBE_TTS_MODEL_DIR=/path/to/models
# The directory must already exist; download_models.py creates only the model subfolder in it.
#VIBE_TTS_MODEL_DIR=

# Where generated audio is written. Default: ./outputs
#VIBE_TTS_OUTPUT_DIR=

# Hugging Face cache and token location. Default: ~/.cache/huggingface
#HF_HOME=

# Force a backend instead of auto-detecting cuda > mps > cpu (cuda | mps | cpu).
#VIBE_TTS_DEVICE=
